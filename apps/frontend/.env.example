# Internal URL the Next.js server uses to call the Go API (cluster DNS in k8s)
API_URL=http://localhost:8080

# Public origin of the website (canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared with the backend so it can purge ISR cache tags
REVALIDATE_SECRET=change_me_revalidate_secret
